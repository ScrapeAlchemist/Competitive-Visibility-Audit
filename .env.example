# Bright Data (required)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp
BRIGHTDATA_WEB_UNLOCKER_ZONE=unlocker

# Claude Code CLI (optional - defaults to "claude" on PATH)
# CLAUDE_CLI_PATH=claude

# SMTP for email reports (optional - email button disabled without these)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=reports@example.com
# SMTP_SECURE=false
